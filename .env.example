# RouterOS REST API address, including protocol and optional port.
# Examples:
# ROS_URL=http://10.1.1.1
# ROS_URL=http://10.1.1.1:80
# ROS_URL=https://10.1.1.1:443
ROS_URL=http://10.1.1.1

# RouterOS account with read,api,rest-api permissions.
ROS_USER=dash
ROS_PASSWORD=change-me

# Optional WAN interface name used by the dashboard.
WAN_INTERFACE=pppoe-out1
